# LiteLLM proxy URL (the proxy itself, not the upstream provider)
LITELLM_PROXY_URL=http://localhost:4000

# LiteLLM API key — master key or a virtual key (sent as Bearer token)
LITELLM_API_KEY=sk-your-key-here

# Transport mode: stdio (default, for Claude Code) or streamable-http
LITELLM_TRANSPORT=stdio

# Optional tuning
# LITELLM_TIMEOUT_SECONDS=30
# LITELLM_MAX_RETRIES=2
